'use client'

import { useEffect, useState } from 'react'
import { useParams } from 'next/navigation'
import { supabase } from '@/lib/supabase'
import { useAuth } from '@/contexts/AuthContext'
import type { Investor, MonthlyReport } from '@/types'

const MONTH_NAMES = ['1月','2月','3月','4月','5月','6月','7月','8月','9月','10月','11月','12月']
const fmt = (n: number) => `NT$ ${Math.round(n).toLocaleString()}`

type Form = {
  year: number; month: number
  revenue: string; total_cost: string; net_profit: string; note: string
}

function emptyForm(y: number, m: number): Form {
  return { year: y, month: m, revenue: '', total_cost: '', net_profit: '', note: '' }
}

export default function ProfitPage() {
  const { id } = useParams<{ id: string }>()
  const { profile } = useAuth()
  const isAdmin = profile?.role === 'super_admin' || profile?.role === 'manager'

  const now = new Date()
  const today = now.getDate()
  const isDeadlineZone = today >= 1 && today <= 4

  const [reports, setReports] = useState<MonthlyReport[]>([])
  const [investors, setInvestors] = useState<Investor[]>([])
  const [loading, setLoading] = useState(true)
  const [showForm, setShowForm] = useState(false)
  const [form, setForm] = useState<Form>(emptyForm(now.getFullYear(), now.getMonth() + 1))
  const [editId, setEditId] = useState<string | null>(null)
  const [saving, setSaving] = useState(false)
  const [expanded, setExpanded] = useState<string | null>(null)
  const [deleteConfirm, setDeleteConfirm] = useState<string | null>(null)

  async function load() {
    setLoading(true)
    const [{ data: r }, { data: inv }] = await Promise.all([
      supabase.from('monthly_reports').select('*').eq('store_id', id)
        .order('year', { ascending: false }).order('month', { ascending: false }),
      supabase.from('investors').select('*').eq('store_id', id).order('round'),
    ])
    setReports(r || [])
    setInvestors(inv || [])
    setLoading(false)
  }

  useEffect(() => { load() }, [id]) // eslint-disable-line

  function startAdd() {
    setEditId(null)
    setForm(emptyForm(now.getFullYear(), now.getMonth() + 1))
    setShowForm(true)
  }

  function startEdit(r: MonthlyReport) {
    setEditId(r.id)
    setForm({ year: r.year, month: r.month, revenue: String(r.revenue), total_cost: String(r.total_cost), net_profit: String(r.net_profit), note: r.note || '' })
    setShowForm(true)
  }

  async function save() {
    setSaving(true)
    const payload = {
      store_id: id,
      year: form.year, month: form.month,
      revenue: Number(form.revenue) || 0,
      total_cost: Number(form.total_cost) || 0,
      net_profit: Number(form.net_profit) || 0,
      note: form.note || null,
    }
    if (editId) {
      await supabase.from('monthly_reports').update(payload).eq('id', editId)
    } else {
      await supabase.from('monthly_reports').upsert(payload, { onConflict: 'store_id,year,month' })
    }
    setSaving(false)
    setShowForm(false)
    load()
  }

  async function del(rid: string) {
    await supabase.from('monthly_reports').delete().eq('id', rid)
    setDeleteConfirm(null)
    load()
  }

  function handleNumChange(key: 'revenue' | 'total_cost' | 'net_profit', val: string) {
    setForm(prev => {
      const next = { ...prev, [key]: val }
      if (key === 'revenue' || key === 'total_cost') {
        const rev = key === 'revenue' ? Number(val) : Number(prev.revenue)
        const cost = key === 'total_cost' ? Number(val) : Number(prev.total_cost)
        if (rev || cost) next.net_profit = String(rev - cost)
      }
      return next
    })
  }

  const latestReport = reports[0]

  const inputCls = 'w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-orange-200 bg-white'

  if (loading) return <div className="flex items-center justify-center h-64"><p className="text-gray-400 text-sm">載入中...</p></div>

  return (
    <div className="p-4 sm:p-6 max-w-5xl mx-auto">

      {/* Deadline Banner */}
      {isDeadlineZone && (
        <div className="mb-4 p-3 bg-amber-50 border border-amber-200 rounded-xl flex items-start gap-3">
          <span className="text-xl shrink-0 mt-0.5">⏰</span>
          <div>
            <p className="text-sm font-semibold text-amber-800">本月財報截止提醒</p>
            <p className="text-xs text-amber-600 mt-0.5">每月 5 號前（請在 4 號前完成）需上傳當月營業額、總成本與淨利，系統將自動計算各股東分潤</p>
          </div>
        </div>
      )}

      {/* Header */}
      <div className="flex items-start justify-between mb-6 gap-3">
        <div>
          <h1 className="text-xl font-bold text-gray-900">月財務報告</h1>
          <p className="text-sm text-gray-400 mt-0.5">上傳每月營業數據，股東可在「股東入口」查看自己的分潤</p>
        </div>
        {isAdmin && (
          <button onClick={startAdd} className="shrink-0 px-4 py-2 bg-orange-500 text-white rounded-xl text-sm font-semibold hover:bg-orange-600 transition-colors shadow-sm">
            + 新增月報
          </button>
        )}
      </div>

      {/* Stats */}
      {latestReport && (
        <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
          {[
            { label: '最新月營業額', val: fmt(latestReport.revenue), color: 'text-blue-600', icon: '💹' },
            { label: '最新月總成本', val: fmt(latestReport.total_cost), color: 'text-red-500', icon: '📤' },
            { label: '最新月淨利', val: fmt(latestReport.net_profit), color: 'text-emerald-600', icon: '📈' },
            { label: '已上傳期數', val: `${reports.length} 期`, color: 'text-violet-600', icon: '📋' },
          ].map(s => (
            <div key={s.label} className="bg-white rounded-2xl border border-gray-100 p-4 shadow-sm">
              <div className="flex items-center gap-1.5 mb-1.5">
                <span className="text-base">{s.icon}</span>
                <p className="text-xs text-gray-400 truncate">{s.label}</p>
              </div>
              <p className={`text-base font-bold ${s.color}`}>{s.val}</p>
            </div>
          ))}
        </div>
      )}

      {/* Reports List */}
      {reports.length === 0 ? (
        <div className="bg-white rounded-2xl border border-gray-100 p-12 text-center shadow-sm">
          <p className="text-4xl mb-3">📊</p>
          <p className="text-gray-600 font-medium">尚無月財報</p>
          <p className="text-gray-400 text-sm mt-1">上傳第一份月報後，股東即可在「股東入口」查看分潤</p>
        </div>
      ) : (
        <div className="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
          <div className="overflow-x-auto">
            <table className="w-full text-sm min-w-[600px]">
              <thead>
                <tr className="border-b border-gray-100">
                  {['月份', '營業額', '總成本', '淨利', '股東總分潤', ''].map(h => (
                    <th key={h} className="px-4 py-3 text-left text-xs font-semibold text-gray-400 uppercase tracking-wide whitespace-nowrap">{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {reports.flatMap(r => {
                  const totalInvPct = investors.reduce((s, i) => s + (i.percentage || 0), 0)
                  const totalDist = r.net_profit * totalInvPct / 100
                  const isExp = expanded === r.id
                  return [
                    <tr key={r.id} className="border-b border-gray-50 hover:bg-gray-50/50 transition-colors">
                      <td className="px-4 py-3 font-semibold text-gray-800 whitespace-nowrap">{r.year}年 {MONTH_NAMES[r.month - 1]}</td>
                      <td className="px-4 py-3 text-gray-700">{fmt(r.revenue)}</td>
                      <td className="px-4 py-3 text-red-500">{fmt(r.total_cost)}</td>
                      <td className="px-4 py-3 font-semibold text-emerald-600">{fmt(r.net_profit)}</td>
                      <td className="px-4 py-3 text-violet-600">{fmt(totalDist)}</td>
                      <td className="px-4 py-3">
                        <div className="flex items-center gap-3">
                          <button onClick={() => setExpanded(isExp ? null : r.id)} className="text-xs text-blue-500 hover:underline whitespace-nowrap">{isExp ? '收起' : '明細'}</button>
                          {isAdmin && <>
                            <button onClick={() => startEdit(r)} className="text-xs text-gray-400 hover:text-gray-700">編輯</button>
                            <button onClick={() => setDeleteConfirm(r.id)} className="text-xs text-red-400 hover:text-red-600">刪除</button>
                          </>}
                        </div>
                      </td>
                    </tr>,
                    isExp ? (
                      <tr key={`${r.id}-exp`} className="bg-gray-50/80">
                        <td colSpan={6} className="px-4 py-4">
                          <p className="text-xs font-semibold text-gray-500 mb-2">各股東分潤明細</p>
                          <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2">
                            {investors.map(inv => (
                              <div key={inv.id} className="bg-white rounded-xl border border-gray-100 px-3 py-2">
                                <p className="text-xs font-semibold text-gray-700 truncate">{inv.name}</p>
                                <p className="text-[11px] text-gray-400">{inv.percentage?.toFixed(2)}%</p>
                                <p className="text-sm font-bold text-emerald-600">{fmt(r.net_profit * (inv.percentage || 0) / 100)}</p>
                              </div>
                            ))}
                          </div>
                          {r.note && <p className="mt-2 text-xs text-gray-400">備註：{r.note}</p>}
                        </td>
                      </tr>
                    ) : null,
                  ].filter(Boolean)
                })}
              </tbody>
            </table>
          </div>
        </div>
      )}

      {/* Add/Edit Modal */}
      {showForm && (
        <div className="fixed inset-0 z-50 bg-black/40 flex items-end sm:items-center justify-center p-0 sm:p-4">
          <div className="bg-white w-full sm:max-w-md rounded-t-2xl sm:rounded-2xl p-5 shadow-xl">
            <h3 className="font-bold text-gray-900 text-base mb-4">{editId ? '編輯月報' : '新增月報'}</h3>
            <div className="grid grid-cols-2 gap-3 mb-3">
              <div>
                <label className="text-xs text-gray-500 mb-1 block">年度</label>
                <select className={inputCls} value={form.year} onChange={e => setForm(f => ({ ...f, year: Number(e.target.value) }))}>
                  {[now.getFullYear(), now.getFullYear() - 1, now.getFullYear() - 2].map(y => <option key={y} value={y}>{y}</option>)}
                </select>
              </div>
              <div>
                <label className="text-xs text-gray-500 mb-1 block">月份</label>
                <select className={inputCls} value={form.month} onChange={e => setForm(f => ({ ...f, month: Number(e.target.value) }))}>
                  {MONTH_NAMES.map((m, i) => <option key={i + 1} value={i + 1}>{m}</option>)}
                </select>
              </div>
            </div>
            <div className="space-y-3 mb-3">
              {([
                { label: '月營業額', key: 'revenue', placeholder: '例：800000' },
                { label: '總成本', key: 'total_cost', placeholder: '例：550000' },
                { label: '淨利（輸入前兩項可自動計算）', key: 'net_profit', placeholder: '例：250000' },
              ] as const).map(f => (
                <div key={f.key}>
                  <label className="text-xs text-gray-500 mb-1 block">{f.label}</label>
                  <input type="number" className={inputCls} placeholder={f.placeholder} value={form[f.key]} onChange={e => handleNumChange(f.key, e.target.value)} />
                </div>
              ))}
              <div>
                <label className="text-xs text-gray-500 mb-1 block">備註（可留空）</label>
                <input type="text" className={inputCls} value={form.note} onChange={e => setForm(f => ({ ...f, note: e.target.value }))} />
              </div>
            </div>

            {/* Preview */}
            {form.net_profit && investors.length > 0 && (
              <div className="mb-4 p-3 bg-emerald-50 rounded-xl border border-emerald-100">
                <p className="text-xs font-semibold text-emerald-700 mb-2">分潤預覽</p>
                <div className="grid grid-cols-2 gap-1.5">
                  {investors.slice(0, 8).map(inv => (
                    <div key={inv.id} className="flex justify-between text-xs">
                      <span className="text-emerald-600 truncate max-w-[80px]">{inv.name}</span>
                      <span className="font-semibold text-emerald-800">{fmt(Number(form.net_profit) * (inv.percentage || 0) / 100)}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <div className="flex gap-3">
              <button onClick={() => setShowForm(false)} className="flex-1 py-2.5 border border-gray-200 rounded-xl text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors">取消</button>
              <button onClick={save} disabled={saving} className="flex-1 py-2.5 bg-orange-500 text-white rounded-xl text-sm font-semibold hover:bg-orange-600 disabled:opacity-50 transition-colors">
                {saving ? '儲存中...' : '確認儲存'}
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Delete Confirm */}
      {deleteConfirm && (
        <div className="fixed inset-0 z-50 bg-black/40 flex items-center justify-center p-4">
          <div className="bg-white rounded-2xl p-5 shadow-xl max-w-sm w-full">
            <p className="font-bold text-gray-900 mb-1">確認刪除？</p>
            <p className="text-sm text-gray-500 mb-4">此操作無法復原，分潤資料將一併消失</p>
            <div className="flex gap-3">
              <button onClick={() => setDeleteConfirm(null)} className="flex-1 py-2.5 border border-gray-200 rounded-xl text-sm font-medium">取消</button>
              <button onClick={() => del(deleteConfirm)} className="flex-1 py-2.5 bg-red-500 text-white rounded-xl text-sm font-semibold hover:bg-red-600">確認刪除</button>
            </div>
          </div>
        </div>
      )}
    </div>
  )
}
